<%- include('partials/header') %>

<div class="max-w-7xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
            <a href="/rekap" class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-xl transition-colors duration-200">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Kembali ke Rekap
            </a>
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Rekap SKS Asisten</h2>
                <p class="text-sm text-gray-600">Total SKS berdasarkan kehadiran dalam laporan praktikum</p>
            </div>
        </div>
        <div class="flex items-center space-x-3">
            <button class="inline-flex items-center px-4 py-2 bg-green-500 hover:bg-green-600 text-white font-medium rounded-xl transition-colors duration-200">
                <svg class="w-4 h-4 mr-2" data-lucide="download"></svg>
                Export Excel
            </button>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-purple-600" data-lucide="users"></svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-gray-900"><%= totalAsisten %></p>
                    <p class="text-sm text-gray-500">Total Asisten</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-green-600" data-lucide="award"></svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-gray-900"><%= totalSKSKeseluruhan %></p>
                    <p class="text-sm text-gray-500">Total SKS Keseluruhan</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-blue-600" data-lucide="trending-up"></svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-gray-900">
                        <%= rekapAsisten.length > 0 ? (totalSKSKeseluruhan / totalAsisten).toFixed(1) : 0 %>
                    </p>
                    <p class="text-sm text-gray-500">Rata-rata SKS</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-orange-600" data-lucide="star"></svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-gray-900">
                        <%= rekapAsisten.length > 0 ? rekapAsisten[0].totalSKS : 0 %>
                    </p>
                    <p class="text-sm text-gray-500">SKS Tertinggi</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Asisten List -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="bg-gradient-to-r from-purple-50 to-pink-50 p-6 border-b border-gray-100">
            <h3 class="text-lg font-semibold text-gray-800">Detail SKS Per Asisten</h3>
            <p class="text-sm text-gray-600 mt-1">Ranking berdasarkan total SKS yang diperoleh</p>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Ranking</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Asisten</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Total SKS</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Total Kehadiran</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Rata-rata SKS</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Detail</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% rekapAsisten.forEach((asisten, index) => { %>
                        <tr class="hover:bg-gray-50 transition-colors duration-200">
                            <!-- Ranking -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <% if (index === 0) { %>
                                        <div class="w-8 h-8 bg-gradient-to-r from-yellow-400 to-yellow-500 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-white" data-lucide="crown"></svg>
                                        </div>
                                    <% } else if (index === 1) { %>
                                        <div class="w-8 h-8 bg-gradient-to-r from-gray-400 to-gray-500 rounded-full flex items-center justify-center">
                                            <span class="text-white font-bold text-sm">2</span>
                                        </div>
                                    <% } else if (index === 2) { %>
                                        <div class="w-8 h-8 bg-gradient-to-r from-orange-400 to-orange-500 rounded-full flex items-center justify-center">
                                            <span class="text-white font-bold text-sm">3</span>
                                        </div>
                                    <% } else { %>
                                        <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
                                            <span class="text-gray-600 font-bold text-sm"><%= index + 1 %></span>
                                        </div>
                                    <% } %>
                                </div>
                            </td>

                            <!-- Asisten Info -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                                        <span class="text-purple-600 font-bold text-sm">
                                            <%= (asisten.panggilan || asisten.nama_asisten).charAt(0).toUpperCase() %>
                                        </span>
                                    </div>
                                    <div>
                                        <p class="font-semibold text-gray-900"><%= asisten.nama_asisten %></p>
                                        <p class="text-sm text-gray-500"><%= asisten.panggilan || asisten.nama_panjang %></p>
                                    </div>
                                </div>
                            </td>

                            <!-- Total SKS -->
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="text-2xl font-bold text-purple-600"><%= asisten.totalSKS %></span>
                                <p class="text-xs text-gray-500">SKS</p>
                            </td>

                            <!-- Total Kehadiran -->
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="text-lg font-semibold text-gray-900"><%= asisten.totalKehadiran %></span>
                                <p class="text-xs text-gray-500">kali hadir</p>
                            </td>

                            <!-- Rata-rata SKS -->
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="text-lg font-semibold text-gray-900"><%= asisten.averageSKSPerReport %></span>
                                <p class="text-xs text-gray-500">per laporan</p>
                            </td>

                            <!-- Status -->
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <div class="space-y-1">
                                    <% if (asisten.isPjCount > 0) { %>
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <%= asisten.isPjCount %> PJ
                                        </span>
                                    <% } %>
                                    <% if (asisten.regularAssignmentCount > 0) { %>
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            <%= asisten.regularAssignmentCount %> Reguler
                                        </span>
                                    <% } %>
                                </div>
                            </td>

                            <!-- Detail Button -->
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <button onclick="toggleDetail('<%= asisten.id %>')" class="inline-flex items-center px-3 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 font-medium rounded-lg transition-colors duration-200">
                                    <svg class="w-4 h-4 mr-1" data-lucide="eye"></svg>
                                    Detail
                                </button>
                            </td>
                        </tr>

                        <!-- Detail Row (Hidden by default) -->
                        <tr id="detail-<%= asisten.id %>" class="hidden bg-gray-50">
                            <td colspan="7" class="px-6 py-4">
                                <div class="bg-white rounded-lg p-4 border border-gray-200">
                                    <h4 class="font-semibold text-gray-800 mb-3">Detail Kehadiran - <%= asisten.nama_asisten %></h4>
                                    <% if (asisten.detailKehadiran.length > 0) { %>
                                        <div class="overflow-x-auto">
                                            <table class="min-w-full text-sm">
                                                <thead class="bg-gray-100">
                                                    <tr>
                                                        <th class="px-3 py-2 text-left font-semibold text-gray-600">Tanggal</th>
                                                        <th class="px-3 py-2 text-left font-semibold text-gray-600">Mata Kuliah</th>
                                                        <th class="px-3 py-2 text-center font-semibold text-gray-600">Kelas</th>
                                                        <th class="px-3 py-2 text-center font-semibold text-gray-600">SKS</th>
                                                        <th class="px-3 py-2 text-center font-semibold text-gray-600">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-gray-200">
                                                    <% asisten.detailKehadiran.forEach(detail => { %>
                                                        <tr>
                                                            <td class="px-3 py-2 text-gray-900"><%= detail.tanggalFormatted %></td>
                                                            <td class="px-3 py-2">
                                                                <div>
                                                                    <p class="font-medium text-gray-900"><%= detail.courseCode %></p>
                                                                    <p class="text-gray-500 text-xs"><%= detail.courseName %></p>
                                                                </div>
                                                            </td>
                                                            <td class="px-3 py-2 text-center">
                                                                <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs font-medium">
                                                                    <%= detail.kelas %>
                                                                </span>
                                                            </td>
                                                            <td class="px-3 py-2 text-center">
                                                                <span class="font-semibold text-purple-600"><%= detail.sks %></span>
                                                            </td>
                                                            <td class="px-3 py-2 text-center">
                                                                <% 
                                                                let statusClass = 'bg-gray-100 text-gray-700';
                                                                if (detail.status === 'hadir') statusClass = 'bg-green-100 text-green-800';
                                                                else if (detail.status === 'pengganti') statusClass = 'bg-blue-100 text-blue-800';
                                                                else if (detail.status === 'libur') statusClass = 'bg-yellow-100 text-yellow-800';
                                                                %>
                                                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium <%= statusClass %>">
                                                                    <%= detail.status %>
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    <% } else { %>
                                        <p class="text-gray-500 text-center py-4">Belum ada kehadiran tercatat</p>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function toggleDetail(assistantId) {
    const detailRow = document.getElementById(`detail-${assistantId}`);
    detailRow.classList.toggle('hidden');
}
</script>

<%- include('partials/footer') %>
