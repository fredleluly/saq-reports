<%- include('partials/header') %>

<style>
    /* Spreadsheet table styles */
    .attendance-table-wrapper {
        overflow-x: auto;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: white;
    }
    .attendance-table {
        border-collapse: collapse;
        font-size: 11px;
        white-space: nowrap;
        min-width: 100%;
    }
    .attendance-table th,
    .attendance-table td {
        border: 1px solid #e2e8f0;
        padding: 4px 6px;
        text-align: center;
        vertical-align: middle;
    }
    .attendance-table thead th {
        background: #1e3a5f;
        color: white;
        font-weight: 600;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    .attendance-table thead th.month-header {
        background: #1e3a5f;
        font-size: 11px;
    }
    /* Sticky left columns */
    .attendance-table th.sticky,
    .attendance-table td.sticky {
        position: sticky;
        z-index: 5;
        background: white;
    }
    .attendance-table thead th.sticky {
        z-index: 15;
        background: #1e3a5f;
    }
    .attendance-table th.col-no,
    .attendance-table td.col-no { left: 0; min-width: 36px; }
    .attendance-table th.col-nama,
    .attendance-table td.col-nama { left: 36px; min-width: 180px; text-align: left; }
    .attendance-table th.col-nim,
    .attendance-table td.col-nim { left: 216px; min-width: 100px; }
    .attendance-table th.col-mk,
    .attendance-table td.col-mk { left: 316px; min-width: 230px; text-align: left; }

    .attendance-table td.col-mk {
        border-right: 2px solid #94a3b8;
    }

    /* Day columns */
    .attendance-table .day-col {
        min-width: 38px;
        max-width: 42px;
        font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
        font-size: 10px;
    }

    /* Color coding */
    .cell-sunday   { background: #3b82f6 !important; color: #fff; }
    .cell-normal   { background: #ffffff; color: #1e293b; font-weight: 600; }
    .cell-tambahan { background: #fbbf24 !important; color: #92400e; font-weight: 700; }
    .cell-diganti  { background: #92400e !important; color: #fef3c7; font-weight: 600; }
    .cell-pengganti{ background: #e2e8f0 !important; color: #1e293b; font-weight: 600; }
    .cell-libur    { background: #ef4444 !important; }

    /* Total columns */
    .attendance-table .total-col {
        min-width: 60px;
        font-weight: 700;
        background: #f8fafc;
    }
    .attendance-table thead .total-col {
        background: #0f2942;
    }
    .attendance-table .total-jam-col {
        min-width: 60px;
        font-weight: 700;
        background: #f1f5f9;
        border-left: 2px solid #94a3b8;
    }
    .attendance-table thead .total-jam-col {
        background: #0f2942;
    }

    /* Row separators between assistants */
    .attendance-table tbody tr.asst-first-row td {
        border-top: 2px solid #94a3b8;
    }

    /* Total row */
    .attendance-table .total-row td {
        background: #f1f5f9;
        font-weight: 700;
        font-size: 11px;
        border-top: 2px solid #64748b;
    }

    /* Sticky left columns need background on hover row */
    .attendance-table tbody tr:hover td:not([class*="cell-"]) {
        background-color: #f8fafc;
    }
    .attendance-table tbody tr:hover td.cell-sunday   { background: #3b82f6 !important; }
    .attendance-table tbody tr:hover td.cell-tambahan { background: #fbbf24 !important; }
    .attendance-table tbody tr:hover td.cell-diganti  { background: #92400e !important; }
    .attendance-table tbody tr:hover td.cell-pengganti{ background: #e2e8f0 !important; }
    .attendance-table tbody tr:hover td.cell-libur    { background: #ef4444 !important; }
</style>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-slate-100 rounded-2xl flex items-center justify-center border border-slate-200">
                <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-bold text-slate-900">Rekap Kehadiran Bulanan</h2>
                <p class="text-sm text-slate-500">Jam hadir asisten berdasarkan data laporan</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <a href="/rekap/export-xlsx" onclick="this.classList.add('pointer-events-none', 'opacity-70'); this.innerHTML = '<svg class=\'animate-spin w-4 h-4 mr-2\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><circle class=\'opacity-25\' cx=\'12\' cy=\'12\' r=\'10\' stroke=\'currentColor\' stroke-width=\'4\'></circle><path class=\'opacity-75\' fill=\'currentColor\' d=\'M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\'></path></svg> Exporting...'; " 
               class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl border border-blue-700 shadow-sm transition-all hover:scale-105 active:scale-95">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                Export Semua (XLSX)
            </a>
            <a href="/rekap/download-exports-zip"
               class="inline-flex items-center px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl border border-slate-200 transition-colors"
               onclick="this.classList.add('pointer-events-none', 'opacity-70'); this.innerHTML = '<svg class=\\'animate-spin w-4 h-4 mr-2\\' fill=\\'none\\' stroke=\\'currentColor\\' viewBox=\\'0 0 24 24\\'><circle class=\\'opacity-25\\' cx=\\'12\\' cy=\\'12\\' r=\\'10\\' stroke=\\'currentColor\\' stroke-width=\\'4\\'></circle><path class=\\'opacity-75\\' fill=\\'currentColor\\' d=\\'M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\\'></path></svg> Downloading...';">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                Download Semua (ZIP)
            </a>

            <a href="/rekap" class="inline-flex items-center px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl border border-slate-200 transition-colors">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Kembali
            </a>
        </div>
    </div>

    <!-- Month Navigation -->
    <div class="bg-white rounded-2xl border border-slate-200 p-5 flex items-center justify-between">
        <a href="/rekap/kehadiran?month=<%= prevMonth %>&year=<%= prevYear %>"
           class="flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl transition-colors border border-slate-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Sebelumnya
        </a>

        <div class="text-center">
            <h3 class="text-2xl font-bold text-slate-900">
                <%= gridData.monthInfo.monthName %> <%= currentYear %>
            </h3>
            <p class="text-xs text-slate-500 mt-1">
                <%= gridData.assistants.length %> asisten • <%= gridData.monthInfo.daysInMonth %> hari
            </p>
        </div>

        <a href="/rekap/kehadiran?month=<%= nextMonth %>&year=<%= nextYear %>"
           class="flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl transition-colors border border-slate-200">
            Berikutnya
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>
    </div>

    <!-- Attendance Table -->
    <div class="attendance-table-wrapper">
        <table class="attendance-table">
            <thead>
                <!-- Row 1: Group headers -->
                <tr>
                    <th rowspan="2" class="sticky col-no">NO</th>
                    <th rowspan="2" class="sticky col-nama">NAMA MAHASISWA</th>
                    <th rowspan="2" class="sticky col-nim">NIM</th>
                    <th rowspan="2" class="sticky col-mk">MATA KULIAH</th>
                    <th colspan="<%= gridData.monthInfo.daysInMonth %>" class="month-header">
                        BULAN, TANGGAL DAN JAM HADIR PELAKSANAAN (DIISI JUMLAH JAM PER HARI)
                        <br><%= gridData.monthInfo.monthName.toUpperCase() %>
                    </th>
                    <th rowspan="2" class="total-col">TOTAL<br>HARI</th>
                    <th rowspan="2" class="total-jam-col">TOTAL<br>JAM<br>HADIR</th>
                </tr>
                <!-- Row 2: Day numbers -->
                <tr>
                    <% gridData.monthInfo.days.forEach(d => { %>
                        <th class="day-col <%= d.isSunday ? 'cell-sunday' : '' %>">
                            <%= d.day %>
                        </th>
                    <% }) %>
                </tr>
            </thead>
            <tbody>
                <% /* Layout: setiap mataKuliahRow = 1 tr. NO/NAMA/NIM/TOTAL_JAM di-rowspan. TOTAL HARI per baris. */ %>
                <% gridData.assistants.forEach((asst, idx) => {
                    const rowCount = asst.mataKuliahRows.length || 1;
                %>
                    <% asst.mataKuliahRows.forEach(function(mkRow, mkIdx) { %>
                    <tr class="<%= mkIdx === 0 ? 'asst-first-row' : '' %>">

                        <% /* NO, NAMA, NIM: hanya di baris pertama, rowspan ke bawah */ %>
                        <% if (mkIdx === 0) { %>
                            <td class="sticky col-no font-bold text-slate-700" rowspan="<%= rowCount %>"><%= idx + 1 %></td>
                            <td class="sticky col-nama text-slate-800 font-semibold text-xs" rowspan="<%= rowCount %>"><%= asst.nama %></td>
                            <td class="sticky col-nim text-slate-500 text-xs" rowspan="<%= rowCount %>"><%= asst.nim %></td>
                        <% } %>

                        <% /* MATA KULIAH: satu per baris */ %>
                        <td class="sticky col-mk text-slate-600 text-xs <%= mkRow.isTambahan ? 'text-yellow-700 font-semibold' : '' %>">
                            <%= mkRow.name %> (<%= mkRow.kelas %>)
                        </td>

                        <% /* Kolom tanggal per matkul */ %>
                        <% gridData.monthInfo.days.forEach(function(d) {
                            var cell = mkRow.cells[d.date] || { jam: 0, status: 'empty' };
                            var cellClass = 'day-col';
                            if (cell.status === 'sunday')          cellClass += ' cell-sunday';
                            else if (cell.status === 'normal')     cellClass += ' cell-normal';
                            else if (cell.status === 'tambahan')   cellClass += ' cell-tambahan';
                            else if (cell.status === 'diganti')    cellClass += ' cell-diganti';
                            else if (cell.status === 'pengganti')  cellClass += ' cell-pengganti';
                            else if (cell.status === 'libur')      cellClass += ' cell-libur';
                        %>
                            <td class="<%= cellClass %>">
                                <% if (cell.jam > 0) { %><%= formatJam(cell.jam) %><% } %>
                            </td>
                        <% }) %>

                        <% /* TOTAL HARI per matkul (tidak di-merge) */ %>
                        <td class="total-col text-blue-700 font-bold">
                            <%= mkRow.totalHari > 0 ? mkRow.totalHari : '' %>
                        </td>

                        <% /* TOTAL JAM: hanya di baris pertama, rowspan ke bawah */ %>
                        <% if (mkIdx === 0) { %>
                            <td class="total-jam-col text-slate-900 font-bold" rowspan="<%= rowCount %>">
                                <%= asst.totalJam > 0 ? Math.round(asst.totalJam) : 0 %>
                            </td>
                        <% } %>

                    </tr>
                    <% }); %>

                    <% /* Jika asisten tidak punya jadwal sama sekali */ %>
                    <% if (asst.mataKuliahRows.length === 0) { %>
                    <tr class="asst-first-row">
                        <td class="sticky col-no font-bold text-slate-700"><%= idx + 1 %></td>
                        <td class="sticky col-nama text-slate-800 font-semibold text-xs"><%= asst.nama %></td>
                        <td class="sticky col-nim text-slate-500 text-xs"><%= asst.nim %></td>
                        <td class="sticky col-mk text-slate-400 text-xs italic">Belum ada jadwal</td>
                        <% gridData.monthInfo.days.forEach(function(d) { %>
                            <td class="day-col <%= d.isSunday ? 'cell-sunday' : '' %>"></td>
                        <% }) %>
                        <td class="total-col">0</td>
                        <td class="total-jam-col">0</td>
                    </tr>
                    <% } %>

                <% }) %>

                <!-- Total Row -->
                <tr class="total-row">
                    <td class="sticky col-no"></td>
                    <td class="sticky col-nama font-bold text-slate-900">TOTAL</td>
                    <td class="sticky col-nim"></td>
                    <td class="sticky col-mk"></td>
                    <% gridData.monthInfo.days.forEach(function(d) {
                        var dayTotal = 0;
                        gridData.assistants.forEach(function(asst) {
                            asst.mataKuliahRows.forEach(function(mkRow) {
                                var c = mkRow.cells[d.date];
                                if (c && c.jam > 0) dayTotal += c.jam;
                            });
                        });
                    %>
                        <td class="day-col <%= d.isSunday ? 'cell-sunday' : '' %>">
                            <% if (dayTotal > 0) { %><%= formatJam(dayTotal) %><% } %>
                        </td>
                    <% }) %>
                    <td class="total-col text-blue-700 font-bold text-sm"><%= gridData.grandTotalHari %></td>
                    <td class="total-jam-col text-slate-900 font-bold text-sm"><%= gridData.grandTotalJam > 0 ? Math.round(gridData.grandTotalJam) : 0 %></td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Legend & Formula -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Keterangan Warna -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
            <h4 class="font-bold text-slate-800 mb-4">Keterangan</h4>
            <div class="space-y-3">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-5 rounded bg-blue-500 border border-blue-600"></div>
                    <span class="text-sm text-slate-600">Minggu</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="w-8 h-5 rounded bg-red-500 border border-red-600"></div>
                    <span class="text-sm text-slate-600">Libur Nasional</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="w-8 h-5 rounded bg-yellow-400 border border-yellow-500"></div>
                    <span class="text-sm text-slate-600">Menggantikan Aslab Lain (Tambahan)</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="w-8 h-5 rounded bg-gray-400 border border-gray-500"></div>
                    <span class="text-sm text-slate-600">Kelas Pengganti</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="w-8 h-5 rounded" style="background: #92400e; border: 1px solid #78350f;"></div>
                    <span class="text-sm text-slate-600">Diganti Aslab Lain</span>
                </div>
            </div>
        </div>

        <!-- Formula -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
            <h4 class="font-bold text-slate-800 mb-4">Formula Perhitungan</h4>
            <div class="space-y-4">
                <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                    <p class="text-sm font-mono text-slate-700">
                        <span class="font-bold text-slate-900">1 SKS</span> = 50 menit
                    </p>
                </div>
                <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                    <p class="text-sm font-mono text-slate-700">
                        <span class="font-bold text-slate-900">1 jam</span> = (SKS × 50) / 60
                    </p>
                </div>
                <div class="mt-3 space-y-1">
                    <p class="text-xs text-slate-500">Contoh:</p>
                    <p class="text-xs text-slate-600">• 2 SKS → (2 × 50) / 60 = <strong>1.67</strong> jam</p>
                    <p class="text-xs text-slate-600">• 3 SKS → (3 × 50) / 60 = <strong>2.50</strong> jam</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('exportSuccess')) {
        Swal.fire({
            title: 'Berhasil!',
            text: 'Semua file Rekap Kehadiran untuk semester ini telah berhasil di-generate ke folder output_export/rekap_kehadiran.',
            icon: 'success',
            confirmButtonText: 'Oke',
            confirmButtonColor: '#1e3a5f',
            borderRadius: '16px'
        });
        
        // Bersihkan URL dari query param agar tidak muncul lagi saat refresh
        window.history.replaceState({}, document.title, window.location.pathname + window.location.search.replace(/[?&]exportSuccess=true/, '').replace(/^&/, '?'));
    }
</script>

<%- include('partials/footer') %>
